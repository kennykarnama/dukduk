FROM ubuntu:22.04 AS cmake-downloader

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/

RUN curl -L https://github.com/Kitware/CMake/archive/refs/tags/v3.30.9.tar.gz | tar -xz

FROM ubuntu:22.04 AS duckdb-downloader

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/

RUN curl -L https://github.com/duckdb/duckdb/archive/refs/tags/v2.0.0.tar.gz | tar -xz

FROM ubuntu:22.04 AS duckdb-builder

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      libssl-dev \
      libssh2-1-dev \
      linux-headers-generic \
      pkg-config \
      python3 \
      unzip \
      zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/

COPY --from=cmake-downloader /src/CMake-3.30.9 /cmake/

WORKDIR /cmake/

RUN ./bootstrap -- -DCMAKE_BUILD_TYPE:STRING=Release
RUN make -j"$(nproc)"
RUN make install

WORKDIR /src/

RUN git clone https://github.com/Microsoft/vcpkg.git \
    && git -C vcpkg checkout 2026.06.24 \
    && sed -i 's/0cc8434dbdfb2e32dd98277ca37c221c1e720dfc2922d49c749e0c70ec0a5e23bf4e15378814e2f17b1dc65ec6ec93d23df5ec31b2f7ed995a4ae36f4522c24a/ecd69b6734be14c467f7db67dd88c0e57ebfad83ce3ddada131ff3e43ac964523e1083d7c7f3803033a9a76adbc32ad26dd2e3aca69884269000ca64130bde07/g' vcpkg/ports/vcpkg-tool-meson/vcpkg-port-config.cmake 2>/dev/null || true \
    && ./vcpkg/bootstrap-vcpkg.sh

ENV VCPKG_ROOT=/src/vcpkg

COPY --from=duckdb-downloader /src/duckdb-2.0.0/ /src/duckdb/

COPY ./extension_config_local.cmake duckdb/extension/extension_config_local.cmake

# GCC 11 does not accept duckdb-nanoarrow and ducklake's implicit unique_ptr upcast here.
# FetchContent populates _deps only during cmake configure, which happens
# inside the first make invocation. We let it run (it will fail at compile
# time on the nanoarrow/ducklake error), patch the files, then finish the build.
RUN cd duckdb \
    && CMAKE_POLICY_VERSION_MINIMUM=3.5 make extension_configuration \
    && { CMAKE_POLICY_VERSION_MINIMUM=3.5 \
           USE_MERGED_VCPKG_MANIFEST=1 \
           VCPKG_TOOLCHAIN_PATH=../vcpkg/scripts/buildsystems/vcpkg.cmake \
           EXTENSION_STATIC_BUILD=1 \
           make -j"$(nproc)" release || true; } \
    && test -f build/release/_deps/nanoarrow_extension_fc-src/src/writer/to_arrow_ipc.cpp \
    && sed -i 's/return local_state;/return unique_ptr<LocalTableFunctionState>(local_state.release());/' build/release/_deps/nanoarrow_extension_fc-src/src/writer/to_arrow_ipc.cpp \
    && test -f build/release/_deps/ducklake_extension_fc-src/src/storage/ducklake_insert.cpp \
    && python3 -c 'p="build/release/_deps/ducklake_extension_fc-src/src/storage/ducklake_insert.cpp"; s=open(p).read(); target="result->children.push_back(std::move(plan));\n\n\treturn result;\n}"; repl="result->children.push_back(std::move(plan));\n\n\treturn unique_ptr<LogicalOperator>(result.release());\n}"; assert target in s; open(p,"w").write(s.replace(target, repl))' \
    && CMAKE_POLICY_VERSION_MINIMUM=3.5 \
      USE_MERGED_VCPKG_MANIFEST=1 \
      VCPKG_TOOLCHAIN_PATH=../vcpkg/scripts/buildsystems/vcpkg.cmake \
      EXTENSION_STATIC_BUILD=1 \
      make -j"$(nproc)" release

FROM ubuntu:22.04 AS appbuilder

ARG TARGETARCH

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      g++ \
      git \
      libcurl4-openssl-dev \
      libexpat1-dev \
      libssh2-1-dev \
      zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64|arm64) GO_ARCH="${TARGETARCH}" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}"; exit 1 ;; \
    esac; \
    curl -fsSL "https://go.dev/dl/go1.24.5.linux-${GO_ARCH}.tar.gz" -o go.tar.gz; \
    tar -C /usr/local -xzf go.tar.gz; \
    rm go.tar.gz

ENV PATH="$PATH:/usr/local/go/bin"

WORKDIR /app/

COPY --from=duckdb-builder /src/duckdb/build/release/**/**/*.a /app/duckdblib/
COPY --from=duckdb-builder /src/duckdb/build/release/**/**/**/**/*.a /app/duckdblib/
COPY --from=duckdb-builder /src/duckdb/build/release/**/*.a /app/duckdblib/
COPY --from=duckdb-builder /src/duckdb/build/release/*.a /app/duckdblib/
COPY --from=duckdb-builder /src/duckdb/build/release/extension/ /app/duckdblib/extension/

COPY ./appgo/ .

RUN CGO_ENABLED=1 CPPFLAGS="-DDUCKDB_STATIC_BUILD" CGO_LDFLAGS="-L./duckdblib -lnanoarrow_extension -lnanoarrow -lnanoarrow_ipc -lflatccrt -lduckdb_fastpforlib -lduckdb_fmt -lduckdb_fsst -lduckdb_hyperloglog -lduckdb_mbedtls -lduckdb_miniz -lduckdb_pg_query -lduckdb_re2 -lduckdb_skiplistlib -lduckdb_utf8proc -lduckdb_yyjson -limdb -lduckdb_static -lmssql_extension -lsshfs_extension -lhttpfs_extension -lduckdb_zstd -ljemalloc_extension -lparquet_extension -lstdc++ -lm -ldl -lminizip-ng -lcore_functions_extension -lexcel_extension -lexpat -lcurl -lssh2 -lz -lssl -lcrypto" go build -tags=duckdb_use_static_lib ./duckdb-tester/main.go

FROM ubuntu:22.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      libcurl4 \
      libssl3 \
      libssh2-1 \
      libexpat1 \
      libstdc++6 \
      zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY --from=appbuilder /app/main main-app
COPY --from=appbuilder /app/duckdblib/ /duckdblib/
